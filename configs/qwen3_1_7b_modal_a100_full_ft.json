{
  "extends": "qwen3_1_7b_base_common.json",
  "data": {
    "source": "/data/corpus/data",
    "cache_dir": "/data/cache",
    "text_column": "full_text",
    "text_column_fallbacks": ["full_paper"],
    "tokenize_batch_size": 32,
    "source_column": null,
    "max_length": 2048,
    "validation_fraction": 0.001,
    "test_fraction": 0.001
  },
  "training": {
    "output_dir": "/runs/qwen3-1.7b-a10080-e02-b16-ga2-v2",
    "run_name": "qwen3-1.7b-a10080-e02-b16-ga2-v2",
    "num_train_epochs": 2,
    "learning_rate": 0.00002,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.01,
    "weight_decay": 0.1,
    "max_grad_norm": 1,
    "per_device_train_batch_size": 16,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 2,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": false
    },
    "optim": "adamw_torch_fused",
    "eval_strategy": "steps",
    "eval_steps": 1000,
    "save_strategy": "steps",
    "save_steps": 1000,
    "save_total_limit": 2,
    "logging_strategy": "steps",
    "logging_steps": 10,
    "dataloader_num_workers": 0,
    "save_safetensors": true,
    "report_to": "none",
    "logging_first_step": true,
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "adam_epsilon": 1e-8
  },
  "runtime": {
    "precision": "bf16",
    "allow_tf32": true
  }
}
